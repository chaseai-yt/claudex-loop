# claudex-loop fallback reviewers — copy to .env (git-ignored) and fill in.
#
# The loop's primary reviewer stays Codex; nothing here changes that. These
# profiles only define what the user can switch to when Codex is out of quota
# (see FALLBACK.md). A switch is never automatic and never silent.
#
# Every profile is an OpenAI-compatible chat-completions endpoint. The scripts
# read the process environment first, then this file (process env wins).
# Keys: prefer *_API_KEY_ENV (points at another env var, e.g. one injected by
# your secret manager) over inlining the key with *_API_KEY.

# Chain order — first entry is the default; --chain walks this list and uses
# the first provider that passes preflight (skips are reported, never silent).
CLAUDEX_REVIEWERS=lmstudio

# --- LM Studio (local server; no key; nothing leaves the machine) ----------
CLAUDEX_REVIEWER_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
CLAUDEX_REVIEWER_LMSTUDIO_MODEL=qwen/qwen3.6-35b-a3b
# Load the model with enough context first (plan + log easily exceed small
# defaults):  lms load qwen/qwen3.6-35b-a3b --context-length 32768 --yes

# --- Ollama (local server; no key) -----------------------------------------
#CLAUDEX_REVIEWER_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
#CLAUDEX_REVIEWER_OLLAMA_MODEL=qwen3:32b

# --- OpenRouter -------------------------------------------------------------
#CLAUDEX_REVIEWER_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#CLAUDEX_REVIEWER_OPENROUTER_MODEL=deepseek/deepseek-r1
#CLAUDEX_REVIEWER_OPENROUTER_API_KEY_ENV=OPENROUTER_API_KEY

# --- OpenAI (per-token API — NOT the ChatGPT subscription Codex uses) -------
#CLAUDEX_REVIEWER_OPENAI_BASE_URL=https://api.openai.com/v1
#CLAUDEX_REVIEWER_OPENAI_MODEL=gpt-5.2
#CLAUDEX_REVIEWER_OPENAI_API_KEY_ENV=OPENAI_API_KEY

# --- Google Gemini (OpenAI-compatibility endpoint) --------------------------
#CLAUDEX_REVIEWER_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#CLAUDEX_REVIEWER_GEMINI_MODEL=gemini-3.1-pro
#CLAUDEX_REVIEWER_GEMINI_API_KEY_ENV=GEMINI_API_KEY

# --- Anthropic (OpenAI-compatibility endpoint) ------------------------------
# Note: if Claude Code is the planner, an Anthropic reviewer is a same-vendor
# review — weaker as a cross-model check. Configure it, but prefer others.
#CLAUDEX_REVIEWER_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
#CLAUDEX_REVIEWER_ANTHROPIC_MODEL=claude-sonnet-5
#CLAUDEX_REVIEWER_ANTHROPIC_API_KEY_ENV=ANTHROPIC_API_KEY

# --- Optional knobs (per profile: _TEMPERATURE, _MAX_TOKENS, _TIMEOUT) ------
#CLAUDEX_REVIEWER_LMSTUDIO_MAX_TOKENS=8192
#CLAUDEX_REVIEWER_LMSTUDIO_TIMEOUT=1800
# Round-1 APPROVED with fewer numbered findings than this = invalid (exit 3):
#CLAUDEX_FALLBACK_MIN_FINDINGS=3
